{
  "name": "openlibing-code-metrics-action",
  "version": "1.0.3",
  "description": "Code metrics scan plugin - detect code scale, avg function LOC, avg cyclomatic complexity, code duplication rate and file duplication rate",
  "main": "dist/index.js",
  "scripts": {
    "test": "node --test",
    "package": "ncc build src/index.js -o dist && node -e \"require('fs').cpSync('src/bin','dist/bin',{recursive:true})\"",
    "build": "npm run package"
  },
  "author": "openLiBing",
  "license": "ISC",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@openlibing/huaweicloud-oidc-client": "0.0.7",
    "axios": "^1.6.0",
    "esdk-obs-nodejs": "^3.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^9.10.0",
    "globals": "^16.5.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.1.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
